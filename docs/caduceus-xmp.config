# exiftool config: names the Caduceus for OM-3 look fields a patched camera writes into a JPG's XMP.
# Use:  exiftool -config caduceus-xmp.config -XMP-cad:all photo.jpg
# Fields and ranges: docs/FORMATS.md ("XMP fields (v1)"), generated from docs/xmp-fields.json.
package Image::ExifTool::UserDefined;

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        cad => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::cad' },
        },
    },
);

%Image::ExifTool::UserDefined::cad = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-cad', 2 => 'Image' },
    NAMESPACE => { 'cad' => 'https://androidfanman.github.io/caduceus-om3/ns/1/' },
    WRITABLE => 'string',
    Version => { Description => 'format version (1)' },
    Look => { Description => 'look or film name from the card' },
    Film => { Description => 'film number 1-20, 0 = own settings' },
    Hue => { Description => 'Hue per colour (12 numbers, Yellow..Yellow-green)' },
    Light => { Description => 'Light per colour (12 numbers, Yellow..Yellow-green)' },
    Saturation => { Description => 'Saturation per colour (12 numbers, Yellow..Yellow-green)' },
    WbOn => { Description => 'value at record offset +36, 0..1' },
    WbAB => { Description => 'value at record offset +37, -7..7' },
    WbGM => { Description => 'value at record offset +38, -7..7' },
    Blacks => { Description => 'value at record offset +39, -5..5' },
    Whites => { Description => 'value at record offset +40, -5..5' },
    Contrast => { Description => 'value at record offset +41, -2..2' },
    Shading => { Description => 'value at record offset +43, -5..5' },
    Shadows => { Description => 'value at record offset +44, -7..7' },
    Midtones => { Description => 'value at record offset +45, -7..7' },
    Highlights => { Description => 'value at record offset +46, -7..7' },
    GlowClarity => { Description => 'value at record offset +47, -5..5' },
    Art => { Description => 'value at record offset +48, 0..5' },
    NR => { Description => 'value at record offset +49, 0..3' },
    VigFix => { Description => 'value at record offset +50, 0..1' },
    Grain => { Description => 'value at record offset +51, 0..3' },
    Sharp => { Description => 'value at record offset +52, -5..2' },
    ShadowColor => { Description => 'value at record offset +53, 0..11' },
    ShadowStrength => { Description => 'value at record offset +54, -5..5' },
    HighlightColor => { Description => 'value at record offset +55, 0..11' },
    HighlightStrength => { Description => 'value at record offset +56, -5..5' },
);

1;  # end
